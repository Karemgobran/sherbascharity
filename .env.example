# GEMINI_API_KEY: Optional for future AI integrations if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
# In production, set a long random 64-character hex string.
SESSION_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"

# DB_PATH: Path to SQLite database file (persistent volume path in production).
DB_PATH="./data/sherbas.db"

# UPLOAD_DIR: Non-public directory for storing sensitive payment proofs & case documents.
UPLOAD_DIR="./data/uploads"

# INITIAL_SETUP_KEY: Optional setup key required on first-run Super Admin creation in production.
# Leave empty during local evaluation; set a secret phrase when deploying publicly before setup.
INITIAL_SETUP_KEY=""

# EXTERNAL NOTIFICATION PROVIDERS (Future Integration - disabled until configured)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
